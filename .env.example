# Copy to .env and adjust. Real environment variables take precedence.

# ollama (default) | openai (any OpenAI-compatible server: LM Studio, vLLM, llama.cpp) | mock (offline, tests)
ARI_PROVIDER=ollama
ARI_MODEL=llama3.2:3b
ARI_EMBED_MODEL=nomic-embed-text
# ARI_BASE_URL=http://localhost:11434

# LM Studio example:
# ARI_PROVIDER=openai
# ARI_BASE_URL=http://localhost:1234/v1
# ARI_MODEL=google/gemma-3-4b
# ARI_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Retrieval: passages below this cosine score are discarded (default: embedder-calibrated, 0.55 for nomic)
# ARI_MIN_SCORE=0.55
# ARI_TOP_K=3
# ARI_MEMORY_TURNS=6
# ARI_TIMEOUT=120
