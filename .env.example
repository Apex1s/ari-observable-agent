# Copy to .env and fill in the two keys. Real environment variables take precedence.
# Default setup is fully remote: nothing runs on your machine except a small Python web server.

# Chat model: Groq (free tier, no card). Key: https://console.groq.com/keys
ARI_PROVIDER=groq
ARI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Embeddings (document search): Gemini (free tier). Key: https://aistudio.google.com/apikey
ARI_EMBED_PROVIDER=gemini
ARI_EMBED_MODEL=gemini-embedding-001
GEMINI_API_KEY=

# Retrieval: passages below this cosine score are discarded. Leave unset to use the
# per-model default, or run `python -m ari calibrate` once and paste its suggestion here.
# ARI_MIN_SCORE=0.65
# ARI_TOP_K=3
# ARI_MEMORY_TURNS=6
# ARI_TIMEOUT=120

# Other providers (all take the same variables):
#   ARI_PROVIDER=gemini   -> chat on Gemini too (ARI_MODEL=gemini-2.5-flash), one key for everything
#   ARI_PROVIDER=openai   -> any OpenAI-compatible endpoint: set ARI_BASE_URL and ARI_API_KEY
#   ARI_PROVIDER=ollama   -> a self-hosted Ollama on a separate server: set ARI_BASE_URL
#   ARI_PROVIDER=mock     -> offline rule-based stand-in used by the tests
