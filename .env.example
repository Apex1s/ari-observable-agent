# Copy to .env to customise. Real environment variables take precedence.
# Ari works with NO keys at all: chat runs on free keyless APIs and retrieval on BM25 keyword search.
# Everything stays remote: nothing but a small Python web server runs on your machine.

# auto (default): Groq if GROQ_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else keyless
# (ch.at GPT-4o -> Pollinations -> LLM7, with automatic failover). Force one with groq | gemini | keyless.
ARI_PROVIDER=auto

# Optional upgrades (free tiers, no card):
#   Groq: faster chat (gpt-oss-120b) + Whisper speech-to-text for `python -m ari voice`  https://console.groq.com/keys
#   Gemini: semantic embeddings (better retrieval than BM25) and/or chat              https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
# ARI_MODEL=openai/gpt-oss-120b
# ARI_EMBED_MODEL=gemini-embedding-001

# Retrieval: passages below this score are discarded. Leave unset for the per-retriever default
# (BM25 0.12, measured on this knowledge base), or run `python -m ari calibrate` with embeddings.
# ARI_MIN_SCORE=0.12
# ARI_TOP_K=4
# ARI_MEMORY_TURNS=6
# ARI_TIMEOUT=120

# Other providers: ARI_PROVIDER=openai (+ ARI_BASE_URL, ARI_API_KEY) for any OpenAI-compatible endpoint,
# ARI_PROVIDER=ollama (+ ARI_BASE_URL) for a self-hosted server elsewhere, ARI_PROVIDER=mock for offline tests.
# The keyless providers forward prompts to third-party hosts: never type personal data.
